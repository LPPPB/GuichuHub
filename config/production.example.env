# Portable host/container runtime locations. Copy outside the checkout to
# /srv/kichu/config/production.env and replace the example values.
KICHU_DOMAIN=dashboard.example.com
KICHU_HOST_WRITE_TOKEN_FILE=/srv/kichu/secrets/write_token
KICHU_HOST_DATA_DIR=/srv/kichu
KICHU_HOST_LOG_DIR=/srv/kichu/logs
KICHU_HOST_BACKUP_DIR=/srv/kichu/backups
KICHU_HOST_POSTGRES_DIR=/srv/kichu/postgres
KICHU_HOST_POSTGRES_SUPERUSER_PASSWORD_FILE=/srv/kichu/secrets/postgres_superuser_password
KICHU_HOST_POSTGRES_API_PASSWORD_FILE=/srv/kichu/secrets/postgres_api_password
KICHU_HOST_POSTGRES_WORKER_PASSWORD_FILE=/srv/kichu/secrets/postgres_worker_password
KICHU_HOST_POSTGRES_MIGRATION_PASSWORD_FILE=/srv/kichu/secrets/postgres_migration_password
KICHU_HOST_POSTGRES_BACKUP_PASSWORD_FILE=/srv/kichu/secrets/postgres_backup_password
KICHU_HOST_API_DATABASE_URL_FILE=/srv/kichu/secrets/api_database_url
KICHU_HOST_WORKER_DATABASE_URL_FILE=/srv/kichu/secrets/worker_database_url
KICHU_HOST_MIGRATION_DATABASE_URL_FILE=/srv/kichu/secrets/migration_database_url
KICHU_HOST_BACKUP_DATABASE_URL_FILE=/srv/kichu/secrets/backup_database_url
# Verified at release build time; backups refuse an absent or "unknown" identity.
KICHU_GIT_TAG=unknown
KICHU_IMAGE_DIGEST=unknown
# Optional build-only package indexes. Keep credentials out of these URLs.
# KICHU_PIP_INDEX_URL=https://pypi.org/simple
# KICHU_DEBIAN_MIRROR_HOST=http://deb.debian.org
# KICHU_PGDG_APT_URL=https://apt.postgresql.org/pub/repos/apt
# KICHU_NPM_REGISTRY=https://registry.npmjs.org/
