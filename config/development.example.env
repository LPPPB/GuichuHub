# Local development runtime locations. Copy to an ignored .env file before use.
# Use the role-specific URL file for the process you start directly.
KICHU_API_DATABASE_URL_FILE=runtime/dev/secrets/api_database_url
KICHU_WORKER_DATABASE_URL_FILE=runtime/dev/secrets/worker_database_url
KICHU_MIGRATION_DATABASE_URL_FILE=runtime/dev/secrets/migration_database_url
KICHU_COOKIE_PATH=runtime/dev/private/bilibili_cookie.json
KICHU_LOG_DIR=runtime/dev/logs
