{$KICHU_DOMAIN} {
    encode zstd gzip
    handle /internal/* {
        respond 404
    }
    handle /__public-pages/* {
        respond 404
    }

    handle /api/* {
        reverse_proxy api:5000
    }

    handle {
        reverse_proxy frontend:8080
    }
}

www.guichuhub.cn {
    redir https://guichuhub.cn{uri} permanent
}
